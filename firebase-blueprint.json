{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An asset or item tracked in the inventory system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "dateRecorded": { "type": "string" },
        "location": { "type": "string" },
        "quantity": { "type": "number" },
        "condition": { "type": "string" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "category", "location", "quantity", "condition"]
    },
    "Category": {
      "title": "Category Setting",
      "description": "Master data for inventory categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Condition": {
      "title": "Condition Setting",
      "description": "Physical condition status setting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "badgeColor": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "badgeColor"]
    },
    "UserAccount": {
      "title": "User Account",
      "description": "Staff or administrator user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Collection of inventory asset documents"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Master categories collection"
    },
    "/conditions/{conditionId}": {
      "schema": { "$ref": "#/entities/Condition" },
      "description": "Master condition statuses collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Master users and staff collection"
    }
  }
}
